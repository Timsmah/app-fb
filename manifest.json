{
  "manifest_version": 3,
  "name": "Facebook Property Extractor",
  "version": "1.0",
  "description": "Extract Facebook property listings (Marketplace & Groups) to PDF — Bangkok Real Estate",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://www.facebook.com/*",
    "https://translate.googleapis.com/*",
    "https://*.fbcdn.net/*",
    "https://*.facebook.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": ["libs/jspdf.umd.min.js", "content.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["libs/jspdf.umd.min.js", "assets/*"],
      "matches": ["https://www.facebook.com/*"]
    }
  ]
}
